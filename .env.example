# PostgreSQL
POSTGRES_USER=site_user
POSTGRES_PASSWORD=site_pass
POSTGRES_DB=site_yonetim

# Backend
DATABASE_URL=postgres://site_user:site_pass@postgres:5432/site_yonetim?sslmode=disable
JWT_SECRET=change-me-in-production-use-strong-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://site_yonetim.localhost,https://site_yonetim.localhost

# Initial Owner Seed (Only created on first startup if no owner exists)
INITIAL_OWNER_PHONE=05000000000
INITIAL_OWNER_EMAIL=admin@siteyonetim.local
INITIAL_OWNER_PASSWORD=change-me-in-production

# Traefik & Routing
SITE_NAME=site-yonetim
SITE_URL=site_yonetim.localhost

# Migrations
RUN_MIGRATIONS=true

# Frontend
VITE_API_URL=/api/v1

