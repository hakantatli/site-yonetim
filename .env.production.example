# ==============================================================================
# BINAPORTAL (Site Yönetim) - Production Environment Configuration
# ==============================================================================
# Sunucuda (OCI) bu dosyayı '.env' olarak kaydedip gizli değerleri doldurunuz.
# ==============================================================================

# ── 1. Proje & Traefik Routing ────────────────────────────────────────────────
SITE_NAME=binaportal
SITE_URL=binaportal.com

# ── 2. PostgreSQL Veritabanı ──────────────────────────────────────────────────
POSTGRES_USER=binaportal_user
POSTGRES_PASSWORD=BURAYA_GUCLU_BIR_DB_SIFRESI_GIRINIZ
POSTGRES_DB=binaportal

# ── 3. JWT & Güvenlik ─────────────────────────────────────────────────────────
# openssl rand -base64 32 ile güçlü bir secret üretebilirsiniz
JWT_SECRET=BURAYA_EN_AZ_32_KARAKTERLIK_GUCLU_JWT_SECRET_GIRINIZ
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── 4. İlk Sistem Yöneticisi (Owner) ──────────────────────────────────────────
# Sadece ilk kurulumda veritabanı boşken otomatik oluşturulur.
INITIAL_OWNER_PHONE=05000000000
INITIAL_OWNER_EMAIL=admin@binaportal.com
INITIAL_OWNER_PASSWORD=BURAYA_GUCLU_BIR_OWNER_SIFRESI_GIRINIZ

# ── 5. Otomatik Migration ─────────────────────────────────────────────────────
RUN_MIGRATIONS=true

# ── 6. Frontend API Base Path ─────────────────────────────────────────────────
VITE_API_URL=/api/v1
